<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DusmpUpdater</AssemblyName>
    <RootNamespace>DusmpUpdater</RootNamespace>
    <Version>1.3.1</Version>
    <ApplicationIcon>../DusmpLauncher/UI/assets/app.ico</ApplicationIcon>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DusmpLauncher/DusmpLauncher.csproj" />
  </ItemGroup>
</Project>
